class Solution {
    public int searchInsert(int[] arr, int target) {

        int lo=0;
        int hi=arr.length-1;
        
        if (target<arr[0]) return 0;
       

        while(lo<=hi){
            int mid = lo+(hi-lo)/2;

            if (arr[mid]>target){
                hi=mid-1;
            }
            if(arr[mid]<target){
                lo=mid+1;
            }
            if (arr[mid]==target){
                return mid;
            }
            
        }
        return lo;
        
    }
}
